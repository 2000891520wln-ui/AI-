# AI_PROVIDER 可选：
# openai | gemini | volcengine | openai-compatible
#
# 不填时会按已配置的 Key 自动推断：
# VOLCENGINE_API_KEY/ARK_API_KEY -> volcengine
# OPENAI_COMPATIBLE_API_KEY -> openai-compatible
# GEMINI_API_KEY -> gemini
# 否则默认 openai

# OpenAI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# 火山引擎方舟 / 豆包视觉模型
# AI_PROVIDER=volcengine
# VOLCENGINE_API_KEY=
# VOLCENGINE_MODEL=
# 可选：插件“生成 Prompt”等 fast 请求使用的快速视觉模型；不填则使用 VOLCENGINE_MODEL
# VOLCENGINE_FAST_MODEL=
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions

# 通用 OpenAI-compatible 视觉模型
# AI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_MODEL=
# OPENAI_COMPATIBLE_BASE_URL=https://example.com/v1

# Supabase 第一阶段：匿名登录 + 私有 Storage + Postgres
# 前端匿名登录需要这两个 VITE_ 变量；后端 /api/auth/config 也会返回它们。
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 后端验证用户 token、上传私有 Storage 需要 service role key。
# 只放后端环境，不能暴露到浏览器或 GitHub。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=journal-images

# 数据库连接建议使用 Supabase Postgres connection string。
DATABASE_URL=
